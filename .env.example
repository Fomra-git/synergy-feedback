# =============================================================================
# Synergy Feedback — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are ever sent to the browser.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Timezone used for submission numbers and "today/this week" statistics
APP_TIMEZONE=Asia/Kolkata

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
# e.g. "Synergy Feedback <notifications@synergywellness.com>" (verified domain)
EMAIL_FROM=

# --- Google OAuth / Sheets ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# Set to "false" to drop the drive.metadata.readonly scope (spreadsheet
# browsing). Admins can then still create sheets or paste a spreadsheet URL.
GOOGLE_DRIVE_LISTING=true

# Google Search Console "HTML tag" verification code (only the content value,
# e.g. abc123...). Proves you own the site for Google OAuth app verification.
GOOGLE_SITE_VERIFICATION=

# --- Secrets (server only) ---------------------------------------------------
# 32-byte key, base64 encoded. Encrypts Google OAuth tokens at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Random string used to sign OAuth state, upload tokens and hash IPs.
# Generate: openssl rand -base64 48
APP_SECRET=
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=

# --- CAPTCHA (optional, Cloudflare Turnstile) --------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
